<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Share Extension's half of the App Group. It must be byte-identical
	     to the array in App/RetouchPro.entitlements and to
	     RPCore.ShareHandoff.appGroupIdentifier: the group container is the only
	     place these two processes can hand a file to each other.
	     iOS only — there is no macOS Share Extension (docs/PLAN.md §Phase 3B
	     item 1), so App/RetouchPro-macOS.entitlements is unchanged. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.duynguyen.RetouchPro</string>
	</array>
</dict>
</plist>
