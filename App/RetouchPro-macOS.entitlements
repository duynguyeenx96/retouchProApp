<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS-only entitlements. Identical to App/RetouchPro.entitlements plus the
  Photos key, which exists on macOS only (docs/ADR-0003 §5): a sandboxed Mac app
  cannot read PHPhotoLibrary without it, while on iOS the same string is not an
  entitlement at all — access there is the NSPhotoLibraryUsageDescription prompt,
  which is in the generated Info.plist.

  `com.apple.security.files.user-selected.read-write` is what makes the
  `.fileImporter` panel's URLs readable; RPImport brackets each of them in
  `startAccessingSecurityScopedResource()` (ImportOptions.usesSecurityScopedAccess).

  ImageCaptureCore (`com.apple.security.device.usb`) is deliberately **not** here:
  MTP camera import has no UI yet.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
