# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/

# Test / bench artifacts (results are committed deliberately, not incidentally)
*.xcresult

# macOS
.DS_Store

# Phase 0 spike S1 (Research/spikes/S1-landmark): reproducible from the scripts,
# too large to version. The report, the measurement JSON and the converted
# .mlpackage that RPVisionTests consumes are tracked; the rest is not.
Research/spikes/*/.venv/
Research/spikes/*/.venv-mp/
Research/spikes/*/images/
Research/spikes/*/crops/
Research/spikes/*/mp_crops/
Research/spikes/*/candidates.json
Research/spikes/S1-landmark/models/*.tflite
Research/spikes/S1-landmark/models/*.task
Research/spikes/S1-landmark/results/swift_roi_sweep.json
Research/spikes/S1-landmark/results/mp_reference.json

# Phase 0 spike S2 (Research/spikes/S2-face-parsing). Same rule: the report, the
# measurement JSON, the label PNGs, the overlays and the one .mlpackage that
# RPVisionTests loads are tracked; the inputs and the fp32/fp16 comparison builds
# are regenerated by fetch_*.py / convert_bisenet_to_coreml.py.
#   models/79999_iter.pth                53 MB  fetch_model.py, SHA-256 pinned
#   models/FaceParsing19_logits_*        75 MB  only verify_coreml_vs_torch.py uses them
#   a6300*/images/                      190 MB  sips-decoded 24 MP frames + crops
Research/spikes/S2-face-parsing/models/*.pth
Research/spikes/S2-face-parsing/models/FaceParsing19_logits_fp16.mlpackage/
Research/spikes/S2-face-parsing/models/FaceParsing19_logits_fp32.mlpackage/
Research/spikes/S2-face-parsing/a6300/images/
Research/spikes/S2-face-parsing/a6300_upright/images/
Research/spikes/S2-face-parsing/fixture/
Research/spikes/S2-face-parsing/results/torch_logits/

# Phase 0 spike S3 (Research/spikes/S3-guided-filter-mls). Same rule again: the
# report, results/*.json and control/*.json are tracked — control/ is only 132 KB
# and RPEngineTests/SpikeS3BenchTests reads it — while the 178 MB of sips-decoded
# 24 MP frames under images/ is regenerated by the loop in the report §8. images/
# is already covered by `Research/spikes/*/images/` above; named here so the
# omission is deliberate rather than accidental.

# Python bytecode from the spike scripts
__pycache__/
*.pyc

# RAW camera source photos (a6300) — large, regenerable from the shoot, not
# needed to build or test the app.
Research/data/*.ARW

# Converted CoreML models — not pushed to the public repo. This includes the
# three .mlpackages ADR-0015 wires as Sources build inputs for the app itself
# (RetouchPro.xcodeproj references them at these exact paths), so a fresh
# clone needs to re-run the spike conversion scripts before the app builds.
Research/spikes/S1-landmark/models/*.mlpackage/
Research/spikes/S2-face-parsing/models/FaceParsing19.mlpackage/
Packages/RPVision/Tests/RPVisionTests/Phase2/*.mlpackage/
Packages/RPVision/Tests/RPVisionTests/SpikeS1/*.mlpackage/
